{
  "name": "catraca-de-troia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:api:dev\" \"npm:dev:web\"",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:parent": "cross-env VITE_APP_TARGET=parent vite build",
    "preview": "vite preview",
    "api:dev": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "test:api": "tsx --test server/test/*.test.ts",
    "db:backup": "tsx server/maintenance/runBackup.ts",
    "cap:sync": "npm run build:parent && cap sync",
    "cap:sync:android:demo": "cross-env CAPACITOR_ANDROID_SCHEME=http VITE_API_BASE_URL=http://10.0.2.2:3001 npm run build:parent && cross-env CAPACITOR_ANDROID_SCHEME=http cap sync android",
    "android:debug": "npm run cap:sync:android:demo && cd android && ./gradlew assembleDebug",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^2.0.0"
  }
}
