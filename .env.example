# Vazio no desenvolvimento web: o Vite encaminha /api para http://127.0.0.1:3001.
VITE_API_BASE_URL=

# Use "parent" em builds dedicados ao app dos responsáveis.
VITE_APP_TARGET=

# Identificador estável deste servidor escolar na sincronização de eventos.
SYNC_NODE_ID=school-local-demo

# Sem estas duas variáveis, os eventos permanecem preservados na fila SQLite.
SYNC_REMOTE_URL=
SYNC_SHARED_SECRET=

# Variáveis preservadas da exportação original do AI Studio. O código atual não as consome.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
