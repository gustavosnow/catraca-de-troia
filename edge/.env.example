# Copie para edge/.env e preencha. Este arquivo real não vai para o Git.

# API local (o agente roda no mesmo computador da API).
API_URL=http://127.0.0.1:3001

# Token gerado por: npm run device:register -- --id cat-01-entrada --direction ENTRY
DEVICE_TOKEN=

# Origem do vídeo:
#   0, 1, ...                          webcam ou DroidCam/iVCam instalado como webcam
#   http://192.168.0.15:4747/video     DroidCam pela rede (use o IP mostrado no app)
#   http://192.168.0.15:8080/video     IP Webcam (Android)
CAMERA_SOURCE=0

# Similaridade mínima (cosseno SFace) para considerar o rosto reconhecido.
# Referência do OpenCV: 0.363. Comece em 0.45 e calibre com a equipe.
MATCH_THRESHOLD=0.45

# Quadros consecutivos com o mesmo resultado antes de decidir.
FRAMES_REQUIRED=3

# Largura usada no processamento (menor = mais rápido).
PROCESS_WIDTH=640
